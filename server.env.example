# Blasting Intelligence — installation settings. Copy to "server.env" (same folder) and edit.
# Read by start.bat, the background server (install_service.bat) and the administration commands.
# Lines: BI_NAME=value. Environment variables set in Windows take precedence over this file.

# ---- Network ----------------------------------------------------------------------------------
# 127.0.0.1 = this computer only (default). 0.0.0.0 = reachable from the site network.
BI_HOST=0.0.0.0
# 443 is the standard HTTPS port (users then type no port number).
BI_PORT=443
# Address users type in their browser (used for redirects and checks).
BI_PUBLIC_URL=https://blasting.mine.local
# Other names or addresses that reach this server, comma-separated (this computer's own names and IPs are always accepted).
#BI_ALLOWED_HOSTS=blasting,10.20.1.15

# ---- HTTPS ------------------------------------------------------------------------------------
# Made by make_certificate.bat (internal CA) or "python -m app.manage import-pfx FILE" (certificate from IT).
BI_TLS_CERT=C:\BlastingIntelligence\data\tls\server.crt
BI_TLS_KEY=C:\BlastingIntelligence\data\tls\server.key
# Plain-HTTP port that redirects to HTTPS (so typing http://… still works). 0 = none.
BI_HTTP_REDIRECT_PORT=80

# Behind a company reverse proxy that does HTTPS instead (IIS, nginx…): leave BI_TLS_* empty and set
#BI_HOST=127.0.0.1
#BI_TRUSTED_PROXIES=127.0.0.1
#BI_COOKIE_SECURE=1

# ---- Site -------------------------------------------------------------------------------------
BI_TIMEZONE=America/Toronto
# Language of default templates and of texts the system writes into records (en or fr).
BI_DEFAULT_LANGUAGE=fr

# ---- Database and backups (optional) ------------------------------------------------------------
# Default: SQLite file data\blasting.db. Shared PostgreSQL server:
#BI_DATABASE_URL=postgresql+psycopg://blasting:PASSWORD@dbserver:5432/blasting
#BI_BACKUP_DIR=\\fileserver\backups\blasting
#BI_BACKUP_DAILY_AT=02:30
#BI_BACKUP_KEEP=30
